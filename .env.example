# ─── PostgreSQL connection ───────────────────────────────────────
# Replace with YOUR PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Set to "true" only if your Postgres host requires SSL (e.g. some cloud providers)
DATABASE_SSL=false

# ─── Auth ────────────────────────────────────────────────────────
# A long random secret used to sign session tokens (JWT).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ─── External APIs (free, no key needed for the defaults) ─────────
# Open-Meteo (weather) and exchangerate.host / open.er-api.com (currency)
# require no API key. Nothing to set here unless you swap providers.
